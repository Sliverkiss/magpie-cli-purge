{
  "name": "magpie-cli-purge",
  "version": "0.1.0",
  "description": "Magpie gateway plugin that rewrites the system prompt of every agent request from your own persona; pi and omp also get an in-process extension. One switch, zero configuration",
  "type": "module",
  "files": [
    "hooks.mjs",
    "lib/",
    "page/",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "gateway",
    "gateway-hook",
    "opencode",
    "opencode-plugin",
    "system-prompt",
    "persona",
    "prompt",
    "pi",
    "omp",
    "codex",
    "claude",
    "dsh"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "magpie": {
    "icon": "data:image/png;base64,",
    "hooks": "./hooks.mjs",
    "page": {
      "title": "CLI Purge",
      "titles": {
        "zh": "破限",
        "zh-TW": "破限",
        "ja": "パージ",
        "de": "Purge"
      },
      "file": "page/index.html"
    },
    "permissions": [],
    "options": {
      "_comment": "页面:Plugins > CLI Purge(破限)。开关、模式、接管条件(minTools/skipNoQuery/skipNoEnv)和 agents 白名单。",
      "enabled": false,
      "mode": "append",
      "persona": "",
      "agents": [],
      "minTools": 3,
      "skipNoQuery": true,
      "skipNoEnv": true,
      "native": true
    },
    "name": "CLI Purge 破限"
  },
  "author": "Sliverkiss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sliverkiss/magpie-cli-purge.git"
  }
}
